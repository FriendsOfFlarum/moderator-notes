{
    "name": "fof/moderator-notes",
    "description": "Create private notes for your forum users",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/moderator-notes/issues",
        "source": "https://github.com/FriendsOfFlarum/moderator-notes",
        "forum": "https://discuss.flarum.org/d/22925"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0-beta"
    },
    "authors": [
        {
            "name": "IanM",
            "email": "ian@morland.me",
            "role": "Developer"
        },
        {
            "name": "David Sevilla Martin",
            "email": "me+fof@datitisev.me",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\ModeratorNotes\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Moderator Notes",
            "category": "feature",
            "icon": {
                "name": "fas fa-sticky-note",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "fof/impersonate"
            ]
        },
        "branch-alias": {
            "2.x": "2.0.x-dev"
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true
            }
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "require-dev": {
        "flarum/core": "^2.0.0-beta",
        "flarum/markdown": "^2.0.0-beta",
        "flarum/phpstan": "^2.0.0-beta",
        "flarum/testing": "^2.0.0-beta",
        "fof/impersonate": "^2.0.0-beta",
        "symfony/var-dumper": "*"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
